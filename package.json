{
  "name": "frontend-truckit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript contract/openapi.yaml -o src/lib/api/schema.d.ts",
    "api:mock": "prism mock contract/openapi.yaml --host 127.0.0.1 --port 4010",
    "api:sync": "node scripts/sync-contract.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "radix-ui": "1.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "openapi-fetch": "^0.15.0",
    "@fontsource/montserrat": "^5.2.0",
    "@fontsource/inknut-antiqua": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "vitest": "^4.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/jest-dom": "^6.9.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.10.0",
    "@stoplight/prism-cli": "5.14.2",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.11.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.21.3",
  "overrides": {
    "@stoplight/prism-core": "5.8.0",
    "@stoplight/prism-http-server": "5.12.0"
  }
}
